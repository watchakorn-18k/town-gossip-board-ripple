export component CreateRumorDialog(props: {
	onCreate?: (newRumor: { name: string; content: string }) => void;
}) {
	<dialog id="create_rumor_dialog" class="modal">
		<div class="modal-box">
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">
					{'✕'}
				</button>
			</form>
			<h3 class="text-lg font-bold">{'Create Rumor!'}</h3>
			<div class="py-2" />
			<div class="form-control w-full">
				<label class="label">
					<span class="label-text">{'NPC Name'}</span>
				</label>
				<input
					id="npc_name_input"
					type="text"
					placeholder="Type NPC Name"
					class="input input-bordered w-full"
				/>
			</div>
			<label class="label mt-4">
				<span class="label-text">{'Rumor Content'}</span>
			</label>
			<textarea
				id="rumor_content_input"
				class="textarea textarea-bordered w-full"
				placeholder="Type Rumor Content"
			/>
			<div class="py-2" />
			// Clear inputs

			<button
				class="btn btn-primary w-full"
				onclick={() => {
					const nameInput = document.getElementById('npc_name_input') as HTMLInputElement;
					const contentInput = document.getElementById(
						'rumor_content_input',
					) as HTMLTextAreaElement;
					const newRumor = {
						name: nameInput.value,
						content: contentInput.value,
					};
					if (props.onCreate) {
						props.onCreate(newRumor);
					}
					const dialog = document.getElementById(
						'create_rumor_dialog',
					) as HTMLDialogElement;
					dialog.close();

					nameInput.value = '';
					contentInput.value = '';
				}}
			>
				{'Create'}
			</button>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{'close'}</button>
		</form>
	</dialog>
}
