export component Card(props: {
	id: string;
	name: string;
	content: string;
	image_url: string;
	like: number;
	onDelete?: (id) => void;
}) {
	<div class="border-1 border-slate-600 rounded p-2 rumor-card">
		<div class="flex justify-start align-start">
			<div class="flex justify-start align-start gap-2 flex-1">
				<img src={props.image_url} class="w-16 h-16 rounded-full" />
				<div class="flex flex-col">
					<p class="text-md font-bold">{props.name}</p>
					<p class="text-sm overflow-hidden text-ellipsis">{props.content}</p>
				</div>
			</div>
			<button
				class="btn btn-sm btn-circle btn-ghost"
				onclick={() => props.onDelete(props.id)}
			>
				{'✕'}
			</button>
		</div>
	</div>
}

export default Card
