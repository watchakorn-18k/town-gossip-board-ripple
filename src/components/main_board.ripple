import { track, Portal } from 'ripple';
import { v4 as uuidv4 } from 'uuid';
import { Card } from './card.ripple';
import Filter from './filter.ripple';
import { rumorData, npcNames, rumorContents } from '../mock_data/rumor';
import { CreateRumorDialog } from '../components/dialog/create_rumor_dialog.ripple';

export component MainBoard() {
	let rumors = track(rumorData);
	let rumorsAll = track(rumorData);

	const filterByName = (rumors: typeof rumorData, name: string) => {
		if (name === '') return rumors;
		return rumors.filter((r) => r.name === name);
	};

	const filterByDate = (rumors: typeof rumorData, name: string) => {
		if (name === '' || name === 'all') return rumors;
		const now = new Date();
		return rumors.filter((r) => {
			const rumorDate = new Date(r.createAt);
			if (name === 'today') {
				return rumorDate.getDate() === now.getDate() &&
					rumorDate.getMonth() === now.getMonth() &&
					rumorDate.getFullYear() === now.getFullYear();
			} else if (name === 'yesterday') {
				const yesterday = new Date(now);
				yesterday.setDate(now.getDate() - 1);
				return rumorDate.getDate() === yesterday.getDate() &&
					rumorDate.getMonth() === yesterday.getMonth() &&
					rumorDate.getFullYear() === yesterday.getFullYear();
			} else if (name === 'this_week') {
				const weekStart = new Date(now);
				weekStart.setDate(now.getDate() - now.getDay());
				const weekEnd = new Date(weekStart);
				weekEnd.setDate(weekStart.getDate() + 7);
				return rumorDate >= weekStart && rumorDate < weekEnd;
			} else if (name === 'this_month') {
				return rumorDate.getMonth() === now.getMonth() &&
					rumorDate.getFullYear() === now.getFullYear();
			}
			return false;
		});
	};

	const onCreateNewRumor = (newRumor: { name: string; content: string }) => {
		const newRumorWithDetails = {
			...newRumor,
			id: uuidv4(),
			image_url: 'https://api.dicebear.com/9.x/pixel-art/svg?seed=' +
				encodeURIComponent(newRumor.name),
			like: 0,
			createAt: new Date().toISOString(),
		};
		@rumors = [newRumorWithDetails, ...@rumors];
		@rumorsAll = [newRumorWithDetails, ...@rumorsAll];
	};

	const onDeleteRumor = (id: string) => {
		@rumors = @rumors.filter((r) => r.id !== id);
		@rumorsAll = @rumorsAll.filter((r) => r.id !== id);
	};

	const onGenerateRumor = () => {
		const name = npcNames[Math.floor(Math.random() * npcNames.length)];
		const content = rumorContents[Math.floor(Math.random() * rumorContents.length)];
		onCreateNewRumor({ name, content });
	};

	<head>
		<title>{'Town Gossip Board – กระดานข่าวลือของเมือง'}</title>
	</head>

	<Portal target={document.body}>
		<div class="rpgui-content board-scroll" style="overflow-y:scroll;min-height:100dvh;">
			<main
				class="flex flex-col lg:flex-row lg:items-start gap-4 m-4 p-4 inner rpgui-container framed"
				style="position:relative;"
			>
				<Filter
					rumors={@rumorsAll}
					onChange={(keyword) => {
						@rumors = filterByName(rumorData, keyword);
					}}
					onChangeDate={(keyword) => {
						@rumors = filterByDate(rumorData, keyword);
					}}
				/>

				<section
					class="flex-1 rpgui-container framed-grey rounded p-5 min-w-0"
					aria-label="Rumor board"
				>
					<header class="flex items-start gap-4 pb-5" style="border-bottom:1px dashed rgba(217,199,154,0.25);">
						<div class="crest" aria-hidden="true">{'📜'}</div>
						<div class="flex-1 min-w-0">
							<p class="eyebrow">{'Tavern Edition · Vol. III'}</p>
							<h1 class="display-title text-2xl sm:text-3xl mt-1">
								{'Town Gossip Board'}
							</h1>
							<p class="text-sm opacity-75 mt-1" style="text-wrap:pretty;max-width:52ch;">
								{'กระดานข่าวลือของเมือง — every whisper the tavern collected since dawn.'}
							</p>
						</div>
					</header>

					<div class="flex flex-wrap items-center justify-between gap-3 py-4">
						<div class="flex items-center gap-3">
							<span class="count-chip tabular">
								{@rumors.length + ' rumors'}
							</span>
							if (@rumors.length !== @rumorsAll.length) {
								<span class="text-xs opacity-60 tabular">
									{'of ' + @rumorsAll.length}
								</span>
							}
						</div>
						<div class="flex items-center gap-2">
							<button
								class="rpgui-button"
								onclick="create_rumor_dialog.showModal()"
								title="Open the new rumor form"
							>
								{'+ New rumor'}
							</button>
							<button
								class="rpgui-button golden"
								onclick={onGenerateRumor}
								title="Conjure a random whisper"
							>
								{'⚡ Conjure'}
							</button>
						</div>
					</div>

					if (@rumors.length === 0) {
						<div class="empty-scroll">
							<p class="display-title text-lg">{'The scroll is blank.'}</p>
							<p class="text-sm opacity-70 mt-2" style="text-wrap:pretty;">
								{'No rumors match the current filter. Reset the scroll, or conjure a fresh one.'}
							</p>
							<div class="mt-4">
								<button class="rpgui-button" onclick={onGenerateRumor}>
									{'⚡ Conjure a rumor'}
								</button>
							</div>
						</div>
					}

					<div class="flex flex-col gap-2">
						for (const rumor of @rumors) {
							<div class="rumor-row">
								<Card
									id={rumor.id}
									name={rumor.name}
									content={rumor.content}
									image_url={rumor.image_url}
									like={rumor.like}
									createAt={rumor.createAt}
									onDelete={onDeleteRumor}
								/>
							</div>
						}
					</div>

					<footer class="scroll-footer">
						{'sealed by the tavern keeper · do not believe everything'}
					</footer>
				</section>
			</main>
			<CreateRumorDialog onCreate={onCreateNewRumor} />
		</div>
	</Portal>
}

export default MainBoard
