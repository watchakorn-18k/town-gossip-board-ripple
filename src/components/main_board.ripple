import { track } from 'ripple';
import { Card } from './card.ripple';
import Filter from './filter.ripple';
import { rumorData } from '../mock_data/rumor';
import { CreateRumorDialog } from '../components/dialog/create_rumor_dialog.ripple';

export component MainBoard() {
	let rumors = track(rumorData);
	let rumorsAll = track(rumorData);
	const filterByName = (rumors: typeof rumorData, name: string) => {
		if (name === '') {
			return rumors;
		}
		return rumors.filter((r) => r.name === name);
	};

	const filterByDate = (rumors: typeof rumorData, name: string) => {
		if (name === '' || name === 'all') {
			return rumors;
		}
		const now = new Date();
		return rumors.filter((r) => {
			const rumorDate = new Date(r.createAt);
			console.log('Filtering by date:', name, 'Rumor date:', rumorDate);
			if (name === 'today') {
				return rumorDate.getDate() === now.getDate() &&
					rumorDate.getMonth() === now.getMonth() &&
					rumorDate.getFullYear() === now.getFullYear();
			} else if (name === 'yesterday') {
				const yesterday = new Date(now);
				yesterday.setDate(now.getDate() - 1);
				return rumorDate.getDate() === yesterday.getDate() &&
					rumorDate.getMonth() === yesterday.getMonth() &&
					rumorDate.getFullYear() === yesterday.getFullYear();
			} else if (name === 'this_week') {
				const weekStart = new Date(now);
				weekStart.setDate(now.getDate() - now.getDay());
				const weekEnd = new Date(weekStart);
				weekEnd.setDate(weekStart.getDate() + 7);
				return rumorDate >= weekStart && rumorDate < weekEnd;
			} else if (name === 'this_month') {
				return rumorDate.getMonth() === now.getMonth() &&
					rumorDate.getFullYear() === now.getFullYear();
			}
			return false;
		});
	};
	const onCreateNewRumor = (newRumor: { name: string; content: string }) => {
		const newRumorWithDetails = {
			...newRumor,
			image_url: 'https://api.dicebear.com/9.x/pixel-art/svg?seed=' +
				encodeURIComponent(newRumor.name),
			like: 0,
			createAt: new Date().toISOString(),
		};
		@rumors = [newRumorWithDetails, ...@rumors];
		@rumorsAll = [newRumorWithDetails, ...@rumorsAll];
	};

	<head>
		<title>{'Town Gossip Board – กระดานข่าวลือของเมือง'}</title>
	</head>
	<h1 class="text-center text-2xl py-8 font-bold">
		{'Town Gossip Board – กระดานข่าวลือของเมือง'}
	</h1>

	<div class="flex flex-col justify-center align-center lg:flex-row lg:gap-4 mx-4">
		<Filter
			rumors={@rumorsAll}
			onChange={(keyword) => {
				const filtered = filterByName(rumorData, keyword);
				console.log('Filtering by:', keyword, 'Result:', filtered);
				@rumors = filtered;
			}}
			onChangeDate={(keyword) => {
				const filtered = filterByDate(rumorData, keyword);
				console.log('Filtering by date:', keyword, 'Result:', filtered);
				@rumors = filtered;
			}}
		/>
		<div class="border-1 border-slate-600 rounded p-4 ">
			<div class="flex justify-between align-center">
				<p class="text-lg py-4 font-bold">{'Rumors'}</p>
				<button class="btn btn-success btn-md" onclick="create_rumor_dialog.showModal()">
					{'Add Rumor'}
				</button>
			</div>

			for (const rumor of @rumors) {
				<div class="py-1">
					<Card
						name={rumor.name}
						content={rumor.content}
						image_url={rumor.image_url}
						like={rumor.like}
					/>
				</div>
			}
		</div>
	</div>
	<CreateRumorDialog onCreate={onCreateNewRumor} />
}

export default MainBoard
