import type { Rumor } from '../models/rumor.ts';

export component Filter(props: {
	rumors: Rumor[];
	onChange: (newKeyword: string) => void;
	onChangeDate: (newDateKeyword: string) => void;
}) {
	// select dropdown for NPC names
	<div
		class="mb-4 border-1 border-slate-600 rounded p-4 min-w-[200px] lg:w-1/4 rpgui-container framed-grey"
		style="animation: slideDownFade 0.5s ease-out;"
	>
		<p class="text-lg py-1 font-bold">{'Filter'}</p>
		<div>
			<p class="py-1 text-sm font-bold">{'NPC'}</p>

			<select class="select w-full" onChange={(e) => props.onChange(e.target.value)}>
				<option value="">{'All'}</option>
				for (const rumor of @props.rumors) {
					<option value={rumor.name}>{rumor.name}</option>
				}
			</select>
		</div>
		<div>
			<p class="py-1 text-sm font-bold">{'Date'}</p>

			<select class="select w-full" onChange={(e) => props.onChangeDate(e.target.value)}>
				<option value="all">{'All'}</option>
				<option value="today">{'Today'}</option>
				<option value="yesterday">{'Yesterday'}</option>
				<option value="this_week">{'This Week'}</option>
				<option value="this_month">{'This Month'}</option>
			</select>
		</div>
	</div>
}
export default Filter
