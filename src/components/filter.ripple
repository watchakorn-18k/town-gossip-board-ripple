import type { Rumor } from '../models/rumor.ts';

export component Filter(props: {
	rumors: Rumor[];
	onChange: (newKeyword: string) => void;
	onChangeDate: (newDateKeyword: string) => void;
}) {
	const onReset = () => {
		const npc = document.getElementById('filter_npc') as HTMLSelectElement;
		const date = document.getElementById('filter_date') as HTMLSelectElement;
		if (npc) npc.value = '';
		if (date) date.value = 'all';
		props.onChange('');
		props.onChangeDate('all');
	};

	<aside
		class="rpgui-container framed-grey rounded p-4 min-w-[220px] lg:w-1/4 filter-sticky"
		style="animation: rumorIn 0.55s cubic-bezier(0.22,1,0.36,1) both;"
	>
		<div class="flex items-baseline justify-between mb-3">
			<p class="eyebrow">{'Scroll · Search'}</p>
			<button
				class="text-xs underline opacity-70 hover:opacity-100"
				onclick={onReset}
				type="button"
			>
				{'reset'}
			</button>
		</div>

		<div class="mb-4">
			<label for="filter_npc" class="eyebrow block mb-1">{'NPC'}</label>
			<select
				id="filter_npc"
				class="select w-full"
				onChange={(e) => props.onChange(e.target.value)}
			>
				<option value="">{'— Anyone in town —'}</option>
				for (const rumor of @props.rumors) {
					<option value={rumor.name}>{rumor.name}</option>
				}
			</select>
		</div>

		<div>
			<label for="filter_date" class="eyebrow block mb-1">{'When'}</label>
			<select
				id="filter_date"
				class="select w-full"
				onChange={(e) => props.onChangeDate(e.target.value)}
			>
				<option value="all">{'Any time'}</option>
				<option value="today">{'Today'}</option>
				<option value="yesterday">{'Yesterday'}</option>
				<option value="this_week">{'This week'}</option>
				<option value="this_month">{'This month'}</option>
			</select>
		</div>

		<hr class="my-4 opacity-30" />

		<p class="text-xs leading-relaxed opacity-70" style="text-wrap:pretty;">
			{'Whispers travel fast. Filter the scroll by teller or by day. The tavern remembers.'}
		</p>
	</aside>
}
export default Filter
